    {
      "declarations": ["input count", "local countPlural = count: plural"],
      "selectors": ["countPlural"],
      "match": { "countPlural=one": "1 mes", "countPlural=other": "{count} meses" }
    }
  ],

  "dashboard_requests_title": "Solicitudes de pago",
  "dashboard_requests_none_pending": "Sin solicitudes pendientes",
  "dashboard_requests_pending_count": [
    {
      "declarations": ["input count", "local countPlural = count: plural"],
      "selectors": ["countPlural"],
      "match": {
        "countPlural=one": "1 solicitud pendiente",
        "countPlural=other": "{count} solicitudes pendientes"
      }
    }
  ],
  "dashboard_requests_reservation_fee": "Tarifa {amenity} - Casa {number}",
  "dashboard_requests_empty_title": "Todo al día",
  "dashboard_requests_empty_description": "Aquí aparecerán las solicitudes pendientes de pago.",

  "dashboard_notices_upcoming": "Próximos eventos",
  "dashboard_notices_date_pattern": "EEEE d 'de' MMMM",
  "dashboard_notices_empty_title": "Sin eventos próximos",
  "dashboard_notices_empty_description": "Aquí aparecerán las reservaciones de las áreas comunes."
