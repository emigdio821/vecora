  "dashboard_no_current_period": "Sin periodo actual",

  "dashboard_treasury_summary": "Resumen del periodo",
  "dashboard_treasury_no_period_description": "Ningún periodo cubre la fecha de hoy. Crea uno en \"Presidencia\" para ver el resumen.",
