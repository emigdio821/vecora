  "dashboard_treasury_month": "Mes",

  "dashboard_fees_title": "Cuotas de mantenimiento",
  "dashboard_fees_current_period": "Periodo actual",
  "dashboard_fees_none_up_to_date": "Ninguna casa está al corriente",
  "dashboard_fees_all_up_to_date": "Todas las casas están al corriente",
  "dashboard_fees_some_up_to_date": "{upToDate} de {total} casas al corriente",
