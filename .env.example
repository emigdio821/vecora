# Copy to .env.local and fill in.

# Where the app runs: Better Auth's base URL (secure cookies on https) and link
# previews (og:url and the og:image URL).
# Local: http://localhost:3000. Production: the deployment's https URL.
VITE_SITE_URL=

# Neon. `neon checkout <branch>` writes all three; local: the `dev` branch.
# DATABASE_URL is pooled (host has "-pooler"): the app's queries.
# DATABASE_URL_UNPOOLED is direct (no "-pooler"): drizzle-kit, the reset and
# pg_dump, which break through the pooler. Only on a developer's machine.
# NEON_BRANCH lets the reset refuse the production branch.
DATABASE_URL=
DATABASE_URL_UNPOOLED=
NEON_BRANCH=

# Server-only. Signs Better Auth's sessions; at least 32 characters, different per
# environment. Generate one with: openssl rand -base64 32
BETTER_AUTH_SECRET=

# Server-only. Neon Object Storage of the same branch (the "assets" bucket in neon.ts).
# `neon deploy` / `neon env pull` write them; or Neon console -> Connect -> Storage.
AWS_ENDPOINT_URL_S3=
AWS_REGION=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# Only for `npm run db:import` (scripts/db/import-supabase.ts), on a developer's
# machine; delete them once the move from Supabase is done. Supabase dashboard ->
# Connect -> Session pooler (port 5432; the direct connection is IPv6-only), with
# the database password filled in. SUPABASE_DB_CA is the path to the certificate
# from Database settings -> SSL configuration -> Download certificate: Supabase
# signs with its own CA, so without it the TLS check fails.
SUPABASE_DB_URL=
SUPABASE_DB_CA=
