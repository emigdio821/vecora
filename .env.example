# Copy to .env.local and fill in.
#
# Hosted project: Dashboard -> Project Settings -> API Keys
# Local stack:    `npx supabase status` (API_URL and PUBLISHABLE_KEY)
VITE_SUPABASE_URL=
VITE_SUPABASE_KEY=

# Where the app runs, for link previews (og:url and the og:image URL).
# Local: http://localhost:3000. Production: https://vecora.vercel.app
VITE_SITE_URL=

# Server-only, never VITE_ (those are bundled into the browser code). Needed to create/remove board member accounts.
# Local: `npx supabase status -o env` (SECRET_KEY). Hosted: Dashboard -> API Keys -> Secret keys.
SUPABASE_SECRET_KEY=

# Neon, as the owner role (neondb_owner), which bypasses RLS: only for scripts,
# drizzle-kit and migrations, never the app's queries. `neon checkout <branch>`
# writes both; local: the `dev` branch. Pooled (host has "-pooler") and direct
# (no "-pooler"), for migrations and pg_dump, which break through the pooler.
DATABASE_URL=
DATABASE_URL_UNPOOLED=

# Server-only. The app's own role on the same branch (pooled), which can't bypass
# RLS. `npm run db:neon:app-role` creates the role and writes this line.
DATABASE_AUTHENTICATED_URL=

# Server-only. Signs Better Auth's sessions; at least 32 characters, different per
# environment. Generate one with: openssl rand -base64 32
BETTER_AUTH_SECRET=

# Server-only. Neon Object Storage of the same branch (the "assets" bucket in neon.ts).
# `neon deploy` / `neon env pull` write them; or Neon console -> Connect -> Storage.
AWS_ENDPOINT_URL_S3=
AWS_REGION=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
