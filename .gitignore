# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# tanstack start
/.output/
/.nitro/
/.tanstack/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# agent skills: .agents/skills is the source of truth (see skills-lock.json);
# .claude/skills only holds symlinks to it, which Git on Windows would copy.
.claude/skills/

# vercel
.vercel

# typescript
*.tsbuildinfo
