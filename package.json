{
  "name": "vecora",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "oxlint --fix",
    "format": "oxfmt",
    "typecheck": "tsc --noEmit",
    "db:types": "supabase gen types typescript --local --schema public > src/lib/supabase/database.types.ts",
