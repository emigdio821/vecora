{
  "name": "vecora",
  "version": "0.8.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vp dev",
    "build": "vp build",
    "start": "node .output/server/index.mjs",
    "lint": "vp lint --fix",
    "format": "vp fmt",
    "i18n": "paraglide-js compile --silent",
    "typecheck": "npm run i18n && tsc --noEmit",
    "db:types": "supabase gen types typescript --local --schema public > src/lib/supabase/database.types.ts",
    "db:reset": "supabase db reset --local",
    "db:reset:empty": "supabase db reset --local --no-seed && supabase db query --local -f supabase/seed.sql",
    "db:seed": "supabase db push --linked --include-seed",
    "prepare": "husky"
  },
  "dependencies": {
    "@base-ui/react": "^1.9.0",
    "@daypicker/react": "^10.0.2",
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource/inter": "^5.3.0",
    "@hookform/resolvers": "^5.9.2",
    "@inlang/paraglide-js-react": "1.0.3",
    "@react-pdf/renderer": "^4.9.0",
    "@resvg/resvg-js": "^2.6.2",
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.118.0",
    "@tabler/icons-react": "^3.49.0",
    "@tanstack/charts": "1.1.0",
    "@tanstack/react-devtools": "^0.10.13",
    "@tanstack/react-query": "^5.104.5",
    "@tanstack/react-query-devtools": "^5.104.5",
    "@tanstack/react-router": "^1.170.46",
    "@tanstack/react-router-devtools": "^1.167.2",
    "@tanstack/react-router-ssr-query": "^1.167.3",
    "@tanstack/react-start": "^1.169.4",
    "@tanstack/react-table": "^9.3.1",
    "@tiptap/extension-file-handler": "^3.32.0",
    "@tiptap/extension-highlight": "^3.32.0",
    "@tiptap/extension-image": "^3.32.0",
    "@tiptap/extension-table": "^3.32.0",
    "@tiptap/extension-text-align": "^3.32.0",
    "@tiptap/markdown": "^3.32.0",
    "@tiptap/pm": "^3.32.0",
    "@tiptap/react": "^3.32.0",
    "@tiptap/starter-kit": "^3.32.0",
    "@vercel/analytics": "^2.0.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "d3-shape": "3.2.0",
    "date-fns": "^4.4.0",
    "libphonenumber-js": "^1.13.15",
    "nuqs": "^2.10.2",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-hook-form": "^7.90.0",
    "react-phone-number-input": "^3.4.18",
    "satori": "^0.63.2",
    "shadcn": "^4.22.1",
    "sharp": "^0.35.5",
    "tailwind-merge": "^3.7.0",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.4",
    "@commitlint/config-conventional": "^21.2.4",
    "@inlang/paraglide-js": "^2.29.1",
    "@tailwindcss/vite": "^4.3.3",
    "@types/d3-shape": "^3.2.0",
    "@types/node": "^24.19.2",
